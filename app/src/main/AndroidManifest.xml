<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Camera permission for barcode scanner (optional) -->
    <uses-permission android:name="android.permission.CAMERA" 
        android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    
    <!-- Google Fit permissions (optional) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" 
        android:required="false" />
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" 
        android:required="false" />
    
    <!-- Storage for potential exports (optional, only for older Android versions) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32"
        android:required="false" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32"
        android:required="false"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".CalorieTrackerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CalorieTracker"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CalorieTracker"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google Fit configuration -->
        <meta-data
            android:name="com.google.android.gms.fitness.CLIENT_NAME"
            android:value="CalorieTracker" />

    </application>

</manifest>
